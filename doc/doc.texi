@node States
@section States
@itemize @bullet
@item @code{START} (0): Initial state, waiting for game start.
@item @code{SPAWN} (1): Preparing initial snake and apple positions.
@item @code{MOVING} (2): Active snake movement.
@item @code{PAUSE} (3): Game paused.
@item @code{GAMEOVER} (6): Game over due to collision.
@item @code{WIN} (8): Game won when snake length reaches 200.
@item @code{EXIT_STATE} (7): Exit game.
@end itemize

@node Transitions
@section Transitions
@itemize @bullet
@item @code{START} -> @code{SPAWN}: On @code{Start} action.
@item @code{SPAWN} -> @code{MOVING}: On @code{NOSIG} action.
@item @code{MOVING} -> @code{PAUSE}: On @code{Pause} action.
@item @code{PAUSE} -> @code{MOVING}: On @code{Pause} action.
@item @code{MOVING} -> @code{GAMEOVER}: On collision.
@item @code{MOVING} -> @code{WIN}: When length = 200.
@item Any state -> @code{EXIT_STATE}: On @code{Terminate} action.
@end itemize

